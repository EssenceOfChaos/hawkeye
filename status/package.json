{
  "name": "hawkeye-status",
  "private": true,
  "type": "module",
  "description": "status.hawkeye.observer: HawkEye's own uptime, measured from Cloudflare, outside HawkEye's server",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply hawkeye-status --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "6.0.3",
    "vitest": "4.0.18",
    "wrangler": "4.153.0"
  }
}
