# The settings a production server needs, and where each goes. scripts/fetch-secrets.py reads this to turn the secret manager (Infisical)
# into files on the server, and refuses to write them when a required value is missing.
#
#   NAME   SCOPE   REQUIRED
#
# SCOPE    app  -> .env.production, which docker compose gives to the containers (the API, the worker and the web server read it)
#          host -> ~/.hawkeye-host.env, read only by scripts on the host (backups, heartbeat). These never enter a container.
# REQUIRED required -> the deploy stops if it is missing or empty;  optional -> may be absent (the app has a default, or the feature is off)
#
# A name that is in the secret manager but not listed here goes to .env.production as optional, and `fetch-secrets.py check` says so.
# KEEP IN STEP WITH deploy/.env.production.example (scripts/test_fetch_secrets.py fails if they drift).
# APP_VERSION is not here: scripts/deploy.sh sets it to the commit being deployed.

# --- Identity of the deployment
SITE_ADDRESS                app   required
WWW_ADDRESS                 app   optional
ACME_EMAIL                  app   required
APP_BASE_URL                app   required
API_BASE_URL                app   required

# --- Database
DATABASE_URL                app   required
POSTGRES_PASSWORD           app   required
POSTGRES_USER               app   optional
POSTGRES_DB                 app   optional
DB_MAX_CONNS                app   optional
ALLOW_INSECURE_DATABASE     app   optional

# --- Secrets
SESSION_SECRET              app   required
SECRETS_ENCRYPTION_KEY      app   required

# --- Email
EMAIL_PROVIDER              app   required
EMAIL_FROM_ADDRESS          app   required
CONTACT_TO_ADDRESS          app   optional
SMTP_HOST                   app   required
SMTP_PORT                   app   optional
SMTP_TLS                    app   optional
SMTP_USERNAME               app   required
SMTP_PASSWORD               app   required

# --- Onboarding emails to new accounts with no monitor (off until LIFECYCLE_FROM_ADDRESS is set; see docs/operations.md)
LIFECYCLE_FROM_ADDRESS      app   optional
LIFECYCLE_REPLY_TO          app   optional
LIFECYCLE_POSTAL_ADDRESS    app   optional
LIFECYCLE_INTERVAL          app   optional
DISABLE_LIFECYCLE_EMAILS    app   optional

# --- Stripe (billing is off until all four are set)
STRIPE_SECRET_KEY           app   optional
STRIPE_WEBHOOK_SECRET       app   optional
STRIPE_PRICE_PRO_ID         app   optional
STRIPE_PRICE_AGENCY_ID      app   optional

# --- Error tracking, logging, limits
SENTRY_DSN                  app   optional
LOG_LEVEL                   app   optional
AUTH_RATE_LIMIT_PER_MIN     app   optional
GLOBAL_RATE_LIMIT_PER_MIN   app   optional
DISABLE_FREE_TOOLS          app   optional
WORKER_CONCURRENCY          app   optional

# --- Canary and domain lookups (defaults are built in)
CANARY_URLS                 app   optional
CANARY_INTERVAL             app   optional
DOMAIN_CHECK_INTERVAL       app   optional
DOMAIN_RECHECK_INTERVAL     app   optional
DOMAIN_LOOKUP_PACE          app   optional
DISABLE_DOMAIN_CHECKS       app   optional

# --- Host-only: nightly off-host backups (scripts/backup-offsite.sh) and the dead-man's switch (scripts/heartbeat.sh)
AGE_RECIPIENT               host  required
BACKUP_ENDPOINT             host  required
BACKUP_BUCKET               host  required
BACKUP_ACCESS_KEY           host  required
BACKUP_SECRET_KEY           host  required
RETENTION_DAYS              host  optional
HEALTHCHECK_URL             host  optional
