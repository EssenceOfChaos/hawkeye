# syntax=docker/dockerfile:1
FROM golang:1.26.11-alpine3.24 AS build
WORKDIR /src
# The module and build caches persist on the build machine between releases (BuildKit cache mounts), so a release recompiles only the packages
# that changed instead of every dependency. Without them every deploy compiled everything from scratch on the server, which outgrew the deploy
# time limit once a large dependency arrived. The caches never end up in the image.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/oauthclient ./cmd/oauthclient

# distroless: no shell, no package manager, runs as an unprivileged user. Pin by digest in your registry for reproducible builds.
FROM gcr.io/distroless/static-debian12:nonroot
# oauthclient registers OAuth clients (Claude); run it on the server like migrate (docs/operations.md#oauth-clients-connecting-claude).
COPY --from=build /out/api /out/migrate /out/oauthclient /usr/local/bin/
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 CMD ["/usr/local/bin/api", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/api"]
