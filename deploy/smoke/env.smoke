# Throwaway settings for the LOCAL production-like test stack (deploy/smoke). Nothing here is a real secret.
SITE_ADDRESS=localhost
ACME_EMAIL=ops@hawkeye.test
HTTP_PORT=8088
HTTPS_PORT=8443
APP_BASE_URL=https://localhost:8443
API_BASE_URL=https://localhost:8443
APP_VERSION=smoke
POSTGRES_USER=hawkeye
POSTGRES_PASSWORD=smoke-test-password
POSTGRES_DB=monitoring
DATABASE_URL=postgres://hawkeye:smoke-test-password@db:5432/monitoring?sslmode=disable
ALLOW_INSECURE_DATABASE=true
SESSION_SECRET=smoke-test-session-secret-0123456789abcdef
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=alerts@hawkeye.test
CONTACT_TO_ADDRESS=support@hawkeye.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=starttls
SMTP_USERNAME=smoke
SMTP_PASSWORD=smoke
SMTP_CA_FILE=/etc/hawkeye/smtp-ca.pem
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MIN=100
