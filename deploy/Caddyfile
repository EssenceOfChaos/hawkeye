# Reverse proxy + static site + automatic HTTPS.
#   SITE_ADDRESS  your domain (e.g. hawkeye.example.com): Caddy obtains and renews a certificate by itself.
#                 Use ":80" only for local testing (plain HTTP, no certificate).
#   ACME_EMAIL    contact address for the certificate authority (expiry notices). Required.
#   WWW_ADDRESS   optional, e.g. www.hawkeye.example.com: gets its own certificate and redirects to SITE_ADDRESS. Unset, it is an unused
#                 listener on :8081 inside the container (nothing is published), so local and smoke stacks are unaffected.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# No referrer at all: one-time tokens in page URLs (?token=) must never travel in a Referer header.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The SPA loads only its own scripts, styles and API, plus Google Analytics (the origins Google documents for gtag.js). Checkout/portal are full-page redirects to Stripe, so no Stripe origins are needed.
		# 'unsafe-inline' for styles is required by the charting library's inline style attributes; scripts stay locked to 'self' and the Google tag origin (no inline scripts: web/src/analytics.ts adds the Google tag from the app bundle unless the visitor opted out).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		-Server
	}
}

{$WWW_ADDRESS::8081} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	import security_headers

	# API, health and readiness go to the API container. Prometheus metrics are NOT proxied (they live on private ports).
	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy api:8080 {
			# The API trusts X-Forwarded-For only from private ranges (TRUST_FORWARDED_FOR=true); Caddy replaces any client-sent value.
			health_uri /healthz
			health_interval 15s
		}
	}

	# Hashed build assets can be cached forever; the HTML shell must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The app is a single-page app, so the server must know which addresses are real pages; anything else gets the same shell with HTTP 404
	# (handle_errors below), and the app renders its 404 page. KEEP IN STEP WITH THE ROUTES IN web/src/App.tsx (web/src/routes.test.ts checks this).
	@app path_regexp app (?i)^/(?:(?:login|register|forgot-password|contact|privacy|terms|reset-password|confirm-alert-address|verify-email|dashboard|billing|account|incidents|notifications|domains|maintenance|status-page|monitoring|monitors(?:/new|/[^/]+(?:/edit)?)?|status/[^/]+))?/?$
	handle @app {
		root * /srv
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else: a real file (hashed assets, icons, email images) is served; a missing one is an error 404 that handle_errors turns into the page.
	handle {
		root * /srv
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		file_server
	}

	# Error pages are separate from the normal route, so they repeat the headers and compression. Other errors keep Caddy's default (empty) body.
	handle_errors {
		import security_headers
		encode zstd gzip
		@missing {
			expression {err.status_code} == 404
			not path /assets/*   # a missing script or style stays a plain 404, never an HTML page in its place
		}
		handle @missing {
			root * /srv
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
	}

	# Access logs must not contain secrets: one-time tokens arrive in the query string of the emailed links, and sessions in cookies.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
