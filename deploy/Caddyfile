# Reverse proxy + static site + automatic HTTPS.
#   SITE_ADDRESS  your domain (e.g. hawkeye.example.com): Caddy obtains and renews a certificate by itself.
#                 Use ":80" only for local testing (plain HTTP, no certificate).
#   ACME_EMAIL    contact address for the certificate authority (expiry notices). Required.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# No referrer at all: one-time tokens in page URLs (?token=) must never travel in a Referer header.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The SPA loads only its own scripts, styles and API. Checkout/portal are full-page redirects to Stripe, so no Stripe origins are needed.
		# 'unsafe-inline' for styles is required by the charting library's inline style attributes; scripts stay locked to 'self'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# API, health and readiness go to the API container. Prometheus metrics are NOT proxied (they live on private ports).
	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy api:8080 {
			# The API trusts X-Forwarded-For only from private ranges (TRUST_FORWARDED_FOR=true); Caddy replaces any client-sent value.
			health_uri /healthz
			health_interval 15s
		}
	}

	# Hashed build assets can be cached forever; the HTML shell must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Access logs must not contain secrets: one-time tokens arrive in the query string of the emailed links, and sessions in cookies.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
