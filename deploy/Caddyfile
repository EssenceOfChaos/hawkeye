# Reverse proxy + static site + automatic HTTPS.
#   SITE_ADDRESS  your domain (e.g. hawkeye.example.com): Caddy obtains and renews a certificate by itself.
#                 Use ":80" only for local testing (plain HTTP, no certificate).
#   ACME_EMAIL    contact address for the certificate authority (expiry notices). Required.
#   WWW_ADDRESS   optional, e.g. www.hawkeye.example.com: gets its own certificate and redirects to SITE_ADDRESS. Unset, it is an unused
#                 listener on :8081 inside the container (nothing is published), so local and smoke stacks are unaffected.
#   STATUS_DOMAINS_ADDRESS, STATUS_DOMAINS_HTTP_ADDRESS
#                 status pages on customers' own domains (docs/plan-status-page-domains.md): "https://" and "http://" serve every other name
#                 (docker-compose.prod.yml sets them). Unset, they are unused listeners on :8082 and :8083, as for WWW_ADDRESS.
#   CADDY_EXTRA_GLOBAL
#                 more global options, for test stacks only: the smoke stack sets "local_certs" so customer domains get certificates from Caddy's
#                 own CA instead of Let's Encrypt. Empty in production.
{
	email {$ACME_EMAIL}
	{$CADDY_EXTRA_GLOBAL}
	# A certificate for a customer's domain is obtained on its first visit, and only for a name the API says serves a status page (a verified
	# domain, on a plan that includes them). Without this check anyone could point names at us and use up our certificate rate limits. The API
	# answers from a short cache, and the path is not proxied from outside (it is not in @backend below).
	on_demand_tls {
		ask http://api:8080/internal/tls/allow
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

# Access logs must not contain secrets: one-time tokens arrive in the query string of the emailed links, and sessions in cookies.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# No referrer at all: one-time tokens in page URLs (?token=) must never travel in a Referer header.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The SPA loads only its own scripts, styles and API, plus Google Analytics (the origins Google documents for gtag.js). Checkout/portal are full-page redirects to Stripe, so no Stripe origins are needed.
		# 'unsafe-inline' for styles is required by the charting library's inline style attributes; scripts stay locked to 'self' and the Google tag origin (no inline scripts: web/src/analytics.ts adds the Google tag from the app bundle unless the visitor opted out).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googletagmanager.com https://bzrcdn.openai.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://bzr.openai.com https://*.google-analytics.com https://*.googletagmanager.com https://*.googleadservices.com https://*.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com https://*.google.com https://*.google.co.uk https://*.google.ca; font-src 'self'; connect-src 'self' https://bzr.openai.com https://bzrcdn.openai.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://*.googleadservices.com https://*.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com https://*.google.com https://*.google.co.uk https://*.google.ca; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		-Server
	}
}

{$WWW_ADDRESS::8081} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	import security_headers

	# API, health and readiness go to the API container, and so do the public uptime badges (/badge/<token>.svg) and heartbeat pings
	# (/ping/<token>, from customers' cron jobs). Prometheus metrics are NOT proxied (they live on private ports).
	@backend path /api/* /mcp /oauth/* /.well-known/oauth-* /healthz /readyz /badge/* /ping/*
	handle @backend {
		reverse_proxy api:8080 {
			# The API trusts X-Forwarded-For only from private ranges (TRUST_FORWARDED_FOR=true); Caddy replaces any client-sent value.
			health_uri /healthz
			health_interval 15s
		}
	}

	# Hashed build assets can be cached forever; the HTML shell must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The app is a single-page app, so the server must know which addresses are real pages; anything else gets the same shell with HTTP 404
	# (handle_errors below), and the app renders its 404 page. KEEP IN STEP WITH THE ROUTES IN web/src/App.tsx (web/src/routes.test.ts checks this).
	@app path_regexp app (?i)^/(?:(?:login|register|forgot-password|contact|docs(?:/(?:getting-started|cron-job-monitoring|api-workflows|dns-monitoring|status-page-domains|alerts|api|claude))?|tools(?:/(?:is-website-down|ssl-certificate-checker|uptime-sla-calculator|downtime-cost-calculator))?|privacy|terms|reset-password|confirm-alert-address|unsubscribe|waitlist/(?:confirm|leave)|accept-invite|verify-email|dashboard|billing|account|incidents|notifications|team|api-keys|security-log|connect|domains|maintenance|reports|status-page|status-pages(?:/[^/]+)?|monitoring|monitors(?:/new|/[^/]+(?:/edit)?)?|status/[^/]+))?/?$
	# Pages with one fixed address have their own copy of the shell with that page's title, description and canonical tags in it
	# (/pages/<name>.html, written by build/prerender-plugin.ts), so crawlers and link previews see them without running JavaScript. The home page is
	# /pages/home.html. Everything else (monitor pages with an id, status pages) gets the neutral /index.html.
	handle / {
		root * /srv
		rewrite * /pages/home.html
		header Cache-Control "no-cache"
		file_server
	}
	handle @app {
		root * /srv
		try_files /pages{path}.html /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else: a real file (hashed assets, icons, email images) is served; a missing one is an error 404 that handle_errors turns into the page.
	handle {
		root * /srv
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		file_server
	}

	# Error pages are separate from the normal route, so they repeat the headers and compression. Other errors keep Caddy's default (empty) body.
	handle_errors {
		import security_headers
		encode zstd gzip
		@missing {
			expression {err.status_code} == 404
			not path /assets/*   # a missing script or style stays a plain 404, never an HTML page in its place
		}
		handle @missing {
			root * /srv
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
	}

	import access_log
}

# Status pages on customers' own domains (status.clientbrand.com). Only the status page is served there: its own small page (status.html, with no
# sign-in, no app and no analytics), the two public reads it makes, and the build's static files. Everything else is a 404, so a customer's
# domain can never show HawkEye's sign-in form or anyone else's page. The API finds the page from the Host header, which Caddy passes on as is.
{$STATUS_DOMAINS_ADDRESS::8082} {
	tls {
		on_demand
	}
	encode zstd gzip

	header {
		# No includeSubDomains: HawkEye must not set policy for the customer's other names.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Our own files only: no analytics or any other third party on a customer's domain.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	@reads path /api/v1/public/domain-status /api/v1/public/domain-status/logo
	handle @reads {
		reverse_proxy api:8080
	}
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle / {
		root * /srv
		rewrite * /status.html
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		respond "Not found" 404
	}

	import access_log
}

# Plain http:// on those names goes to https:// (the certificate challenge on port 80 is answered before this).
{$STATUS_DOMAINS_HTTP_ADDRESS::8083} {
	redir https://{host}{uri} permanent
}
