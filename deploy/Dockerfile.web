# syntax=docker/dockerfile:1
# Builds the React app and serves it with Caddy, which also terminates TLS (automatic HTTPS) and proxies /api to the API.
FROM node:22.23.3-alpine3.24 AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM caddy:2.11.7-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /web/dist /srv
# Validate at build time (placeholder values only here; the real ones are supplied at runtime).
RUN ACME_EMAIL=build-check@example.invalid SITE_ADDRESS=:80 caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
EXPOSE 80 443
