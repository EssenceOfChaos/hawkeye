# syntax=docker/dockerfile:1
FROM golang:1.26.11-alpine3.24 AS build
WORKDIR /src
# The module and build caches persist on the build machine between releases (BuildKit cache mounts), so a release recompiles only the packages
# that changed instead of every dependency. Without them every deploy compiled everything from scratch on the server, which outgrew the deploy
# time limit once a large dependency arrived. The caches never end up in the image.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/worker /usr/local/bin/worker
EXPOSE 9090
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 CMD ["/usr/local/bin/worker", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/worker"]
