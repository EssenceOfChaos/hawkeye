# Production settings. Copy to .env.production (never commit it) and fill in every value.
# Prefer your platform's secret manager for the secrets below; this file is the fallback for a single-host install. chmod 600.

# --- Identity of the deployment
SITE_ADDRESS=hawkeye.example.org          # your domain; Caddy gets a TLS certificate for it automatically
# WWW_ADDRESS=www.hawkeye.example.org     # optional: redirect www to the site (needs a DNS record for www first)
ACME_EMAIL=ops@example.org                # certificate expiry notices
APP_BASE_URL=https://hawkeye.example.org  # must be https:// in production
API_BASE_URL=https://hawkeye.example.org  # same origin: Caddy serves the app and proxies /api
APP_VERSION=1.0.0                         # shown in logs and error reports; also tags the images

# --- Database: a managed PostgreSQL with TLS is strongly recommended
DATABASE_URL=postgres://hawkeye:CHANGE_ME@db.example.org:5432/monitoring?sslmode=verify-full
DB_MAX_CONNS=20
# Only if the database is on a private network you control without TLS (e.g. the local-db profile):
# ALLOW_INSECURE_DATABASE=true
# For --profile local-db also set: POSTGRES_PASSWORD=...

# --- Secrets: generate each with `openssl rand -base64 48`
SESSION_SECRET=CHANGE_ME_to_at_least_32_random_characters
# Encrypts monitor credentials stored in the database. Generate with `openssl rand -base64 32`. Back it up separately from database dumps;
# losing or changing it makes stored credentials unreadable (users would have to re-enter them).
SECRETS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- Email (required: production refuses the console provider). Any SMTP provider works (Resend, SES, Postmark, SendGrid, Mailgun...). Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key>; see docs/deployment.md.
# Where contact-form messages are delivered (forward this inbox to a mailbox you read; replies go to the visitor).
CONTACT_TO_ADDRESS=support@hawkeye.example.org
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=alerts@hawkeye.example.org   # a domain you control, with SPF/DKIM/DMARC configured at your provider
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_TLS=starttls                                # starttls (587) or implicit (465); "none" is refused in production
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- Stripe (billing is off until all four are set). Use live-mode values only when you are ready to take real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_AGENCY_ID=

# --- Error tracking (optional)
SENTRY_DSN=

# --- Logging and limits
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MIN=10
GLOBAL_RATE_LIMIT_PER_MIN=600
# The public SSL certificate checker and website status checker on /tools connect out to hosts visitors name. true switches both off (their
# endpoints answer 503): the first thing to do if they are abused (docs/operations.md#free-tools-abuse).
DISABLE_FREE_TOOLS=false
WORKER_CONCURRENCY=10

# --- Canary: tells this server's own network trouble apart from a customer's site being down (docs/operations.md#canary-our-own-network-is-down)
# CANARY_URLS=                 # empty = Cloudflare, Google and Apple; or a comma-separated list of https URLs; "off" disables
# CANARY_INTERVAL=60s

# --- Domain expiry lookups (RDAP, then WHOIS on port 43). These defaults are built in; set them only to change them.
# DOMAIN_CHECK_INTERVAL=10m    # how often a pass looks for domains that are due
# DOMAIN_RECHECK_INTERVAL=24h  # how long a looked-up domain waits before its next lookup (at least 1h)
# DOMAIN_LOOKUP_PACE=500ms     # pause between lookups, so registries are not hammered
# DISABLE_DOMAIN_CHECKS=false  # true on workers that should not run the lookups
