# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/monitoring?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=10s

# Required in production: >= 32 random chars, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace_with_a_secure_random_secret

LOG_LEVEL=debug
REQUEST_TIMEOUT=30s
BODY_LIMIT=1M
SHUTDOWN_TIMEOUT=15s

SESSION_TTL=336h
# Per-IP requests per minute on auth endpoints (login, register, password reset).
AUTH_RATE_LIMIT_PER_MIN=10
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Used by integration tests only (a disposable database).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/monitoring_test?sslmode=disable

# Monitoring engine (cmd/worker)
WORKER_CONCURRENCY=10
SCHEDULER_INTERVAL=1s
SCHEDULER_BATCH=200
QUEUE_MAX_DEPTH=1000
# Must exceed the longest possible check (max monitor timeout is 30s).
JOB_LEASE=2m
JOB_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL=1s
# Consecutive results needed to confirm an outage / a recovery.
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2
WORKER_METRICS_PORT=9090
# Attempts (with backoff 1m, 5m, 15m, 1h, 3h) before an alert email is marked failed.
NOTIFY_MAX_ATTEMPTS=6
# Set true on worker instances that should not schedule (run exactly one scheduler tier, or several: it is safe).
DISABLE_SCHEDULER=false

# Added in later phases: email, Stripe, worker concurrency, retention, rate limits.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=alerts@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_AGENCY_ID=
